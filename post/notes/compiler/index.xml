	height=&#34;570&#34;
	srcset=&#34;https://invalidval.github.io/p/chapter-5-%E8%AF%AD%E6%B3%95%E5%88%B6%E5%AF%BC%E5%92%8C%E7%BF%BB%E8%AF%91%E6%8A%80%E6%9C%AF/image-6_hu_9763efd6ca23aa69.png 480w, https://invalidval.github.io/p/chapter-5-%E8%AF%AD%E6%B3%95%E5%88%B6%E5%AF%BC%E5%92%8C%E7%BF%BB%E8%AF%91%E6%8A%80%E6%9C%AF/image-6_hu_cf97421a2cd73f6a.png 1024w&#34;
